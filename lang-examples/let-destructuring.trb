// Test let destructuring

use std::io::{Io, print_line}

struct User { name: String, age: Int }

fn main() ->{Io} Nil {
    // Tuple destructuring
    let #(a, b) = #(+1, +2)
    print_line(Int::to_string(a))
    print_line(Int::to_string(b))

    // Nested tuple destructuring
    let #(x, #(y, z)) = #(+10, #(+20, +30))
    print_line(Int::to_string(x))
    print_line(Int::to_string(y))
    print_line(Int::to_string(z))

    // List destructuring
    let [first, second, third] = [+100, +200, +300]
    print_line(Int::to_string(first))
    print_line(Int::to_string(second))
    print_line(Int::to_string(third))

    // List with rest pattern
    let [head, ..tail] = [+1, +2, +3, +4, +5]
    print_line(Int::to_string(head))
    let [next, .._] = tail
    print_line(Int::to_string(next))

    // Record destructuring
    let User { name, age } = User { name: "Alice", age: +30 }
    print_line(name)
    print_line(Int::to_string(age))

    // Record with rest (..)
    let User { name: n, .. } = User { name: "Bob", age: +25 }
    print_line(n)

    // Wildcard in pattern
    let #(keep, _) = #(+42, +999)
    print_line(Int::to_string(keep))
}
