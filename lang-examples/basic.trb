// Basic Example - demonstrates fundamental language features
// - Function definitions with main entry point
// - Built-in arithmetic operations (+, *, etc.)
// - Standard I/O (print_line)
// - Expression evaluation

use std::io::{Io, print_line}

fn main() ->{Io} Nil {
    print_line("Hello, Tribute!")
    print_line(Int::to_string(+10 + +5))
    print_line(Int::to_string(+6 * +7))
}
