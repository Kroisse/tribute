// Let Bindings Example - demonstrates variable scoping
// - Multiple let bindings with lexical scoping
// - Variable references within function scope
// - Sequential variable definitions

use std::io::{Io, print_line}

fn main() ->{Io} Nil {
    let x = +42
    let y = x + +8
    print_line("Testing let bindings:")
    print_line(Int::to_string(x))
    print_line(Int::to_string(y))
    print_line(Int::to_string(x + y))
}
