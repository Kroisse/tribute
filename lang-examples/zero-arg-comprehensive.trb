// Comprehensive zero-arg method tests

use std::io::{Io, print_line}

fn add_one(x: Int) -> Int {
    x + +1
}

fn multiply_by_two(x: Int) -> Int {
    x + x
}

// Test 1: Simple UFCS with parens
fn test1(five: Int) -> Int {
    five.add_one()  // 6
}

// Test 2: Simple UFCS without parens
fn test2(five: Int) -> Int {
    five.add_one  // 6
}

// Test 3: Chained UFCS with parens
fn test3(five: Int) -> Int {
    five.add_one().multiply_by_two()  // (5+1)*2 = 12
}

// Test 4: Chained UFCS without parens
fn test4(five: Int) -> Int {
    five.add_one.multiply_by_two  // (5+1)*2 = 12
}

// Test 5: Mixed (some with parens, some without)
fn test5(five: Int) -> Int {
    five.add_one().multiply_by_two  // (5+1)*2 = 12
}

fn main() ->{Io} Nil {
    let five = +5
    print_line(Int::to_string(test1(five)))
    print_line(Int::to_string(test2(five)))
    print_line(Int::to_string(test3(five)))
    print_line(Int::to_string(test4(five)))
    print_line(Int::to_string(test5(five)))
}
