use std::io::{Io, print_line}

fn greet(name: String, age: Nat) ->{Io} Nil {
    print_line("Hello, \{name}! You are \{age} years old.")
}

fn calculate() ->{Io} Nil {
    let x = 10
    let y = 20
    print_line("\{x} + \{y} = \{x + y}")
}

fn complex_interpolation() ->{Io} Nil {
    let items = 3
    let item_type = "books"
    let price = 15
    print_line("You have \{items} \{item_type} worth \{items * price} dollars total.")
}

fn main() ->{Io} Nil {
    greet("Alice", 30)
    calculate()
    complex_interpolation()
}
