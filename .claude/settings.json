{
    "permissions": {
        "allow": [
            "WebFetch(domain:crates.io)",
            "WebFetch(domain:docs.rs)",
            "Bash(cargo build)",
            "Bash(cargo run)",
            "Bash(cargo test)",
            "Bash(cargo test:*)",
            "Bash(cargo check:*)",
            "Bash(cargo clippy:*)",
            "Bash(cargo fmt:*)",
            "Bash(tree-sitter test:*)",
            "Bash(tree-sitter generate:*)",
            "Bash(tree-sitter parse:*)"
        ],
        "deny": []
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cargo xtask runtime >/dev/null 2>&1 || true",
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash|Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path' | grep '\\.rs$' | xargs -r rustfmt --edition 2024"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": ".ci/lint.sh"
                    }
                ]
            }
        ]
    }
}
