use std::io::{Io, print_line}

enum Inner {
    Value(Nat)
    Empty
}

enum Outer {
    Wrapped(Inner)
    Missing
}

fn read_nested(outer: Outer) -> Nat {
    case outer {
        Wrapped(inner) -> case inner {
            Value(value) -> value
            Empty -> 0
        }
        Missing -> 0
    }
}

fn main() ->{Io} Nil {
    let inner = Value(10)
    let outer = Wrapped(inner)
    let first = read_nested(outer)
    let second = read_nested(outer)
    print_line(Nat::to_string(first + second))
}
