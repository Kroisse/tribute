use std::io::{Io, print_line}

ability State(s) {
    op get() -> s
    op set(value: s) -> Nil
}

fn bump() ->{State(Int)} Int {
    let n = State::get()
    State::set(n + +1)
    n
}

fn run_state() -> Int {
    handle bump() {
        do result { result }
        op State::get() { resume +10 }
        op State::set(value) { resume Nil }
    }
}

// These independently lowered source handles make the baseline profile emit
// multiple equivalent non-capturing identity helpers. The production profile
// must share exactly one helper; the general-arm Escape closures are not part
// of this optimization because they capture their dynamic owner tag.
fn run_state_again() -> Int {
    handle bump() {
        do result { result }
        op State::get() { resume +10 }
        op State::set(value) { resume Nil }
    }
}

fn run_state_once_more() -> Int {
    handle bump() {
        do result { result }
        op State::get() { resume +10 }
        op State::set(value) { resume Nil }
    }
}

fn main() ->{Io} Nil {
    print_line(Int::to_string(run_state()))
}
