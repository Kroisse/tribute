use std::io::{Io, print_line}

ability State(s) {
    op get() -> s
    op set(value: s) -> Nil
}

fn bump() ->{State(Int)} Int {
    let n = State::get()
    State::set(n + +1)
    n
}

fn handle_state(comp: fn() ->{e, State(Int)} Int) ->{e} Int {
    handle comp() {
        do result { result }
        op State::get() { become handle_state(fn() { resume +10 }) }
        op State::set(value) { become handle_state(fn() { resume Nil }) }
    }
}

fn run_state() ->{} Int {
    handle_state(bump)
}

// These independently lowered source handles make the baseline profile emit
// multiple equivalent non-capturing identity helpers. The production profile
// must share exactly one helper; the general-arm Escape closures are not part
// of this optimization because they capture their dynamic owner tag.
fn handle_state_again(comp: fn() ->{e, State(Int)} Int) ->{e} Int {
    handle comp() {
        do result { result }
        op State::get() { become handle_state_again(fn() { resume +10 }) }
        op State::set(value) { become handle_state_again(fn() { resume Nil }) }
    }
}

fn run_state_again() ->{} Int {
    handle_state_again(bump)
}

fn handle_state_once_more(comp: fn() ->{e, State(Int)} Int) ->{e} Int {
    handle comp() {
        do result { result }
        op State::get() { become handle_state_once_more(fn() { resume +10 }) }
        op State::set(value) { become handle_state_once_more(fn() { resume Nil }) }
    }
}

fn run_state_once_more() ->{} Int {
    handle_state_once_more(bump)
}

// The handles above are in tail position, so their arms continue with the
// frame their callable received. A handle whose result is used after it in
// a `Cps` callable continues through a new frame, which its arms and
// completion share with the closures that capture it.
fn handled_then_bumped(comp: fn() ->{e, State(Int)} Int) ->{e, State(Int)} Int {
    let n = handle comp() {
        do result { result }
        op State::get() { resume +1 }
        op State::set(value) { resume Nil }
    }
    n + bump()
}

fn main() ->{Io} Nil {
    let _ = handle_state(fn() handled_then_bumped(bump))
    print_line(Int::to_string(run_state()))
}
