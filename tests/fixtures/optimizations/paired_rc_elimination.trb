use std::io::{Io, print_line}

ability State(s) {
    op get() -> s
    op set(value: s) -> Nil
}

fn bump() ->{State(Int)} Int {
    let n = State::get()
    State::set(n + +1)
    n
}

fn handle_state(comp: fn() ->{e, State(Int)} Int) ->{e} Int {
    handle comp() {
        do result { result }
        op State::get() { handle_state(fn() { resume +10 }) }
        op State::set(value) { handle_state(fn() { resume Nil }) }
    }
}

fn run_state() ->{} Int {
    handle_state(fn() bump())
}

fn main() ->{Io} Nil {
    print_line(Int::to_string(run_state()))
}
