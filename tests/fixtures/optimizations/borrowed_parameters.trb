use std::io::{Io, print_line}

enum BoxedNat {
    Boxed(Nat)
    Wrapped(BoxedNat)
}

fn read_while_borrowing(boxed: BoxedNat) -> Nat {
    case boxed {
        Boxed(value) -> value
        Wrapped(inner) -> read_while_borrowing(inner) + 0
    }
}

fn main() ->{Io} Nil {
    let boxed = Boxed(10)
    print_line(Nat::to_string(read_while_borrowing(boxed)))
}
