core.module @test {
  tribute_control.func @"pkg::sign"['a0](%0: core.i32) -> core.i32 row(| 'a0) inferred {
      %1 = arith.constant -1 : core.i32
      %2 = arith.cmpi eq, %0, %1 : core.i32
      %3 = scf.if %2 -> (core.i32) {
          %4 = arith.constant -100 : core.i32
          scf.yield %4
      } else {
          %5 = arith.constant 0 : core.i32
          %6 = arith.cmpi eq, %0, %5 : core.i32
          %7 = scf.if %6 -> (core.i32) {
              %8 = arith.constant 0 : core.i32
              scf.yield %8
          } else {
              %9 = arith.constant 100 : core.i32
              scf.yield %9
          }
          scf.yield %7
      }
      tribute_control.return %3
  }
}
