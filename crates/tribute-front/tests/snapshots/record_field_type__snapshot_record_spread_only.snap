source: crates/tribute-front/tests/record_field_type.rs
expression: ir_text
---
core.module @test {
  !Config = adt.struct() {fields = [[@debug, core.i1], [@verbose, core.i1]], name = @Config}
  !Config_1 = adt.typeref() {name = @Config}
  !t0 = tribute_control.callable(core.i1, !Config_1) {tribute.calling_convention = 0}

  tribute_control.func @"Config::debug"(%0: !Config_1) -> core.i1 convention(direct) {
      %1 = adt.struct_get %0 {field = 0, type = !Config} : core.i1
      tribute_control.return %1
  }
  tribute_control.func @"Config::verbose"(%0: !Config_1) -> core.i1 convention(direct) {
      %1 = adt.struct_get %0 {field = 1, type = !Config} : core.i1
      tribute_control.return %1
  }
  tribute_control.func @copy_config(%0: !Config_1) -> !Config_1 convention(cps) {
      %1 = adt.struct_get %0 {field = 0, type = !Config} : core.i1
      %2 = adt.struct_get %0 {field = 1, type = !Config} : core.i1
      %3 = adt.struct_new %1, %2 {type = !Config} : !Config_1
      tribute_control.return %3
  }
}
