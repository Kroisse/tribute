      %0 = tribute_control.call {callee = @get_count} : core.i32
      %1 = tribute_control.call {callee = @get_count} : core.i32
      %2 = tribute_control.call %0, %1 {callee = @"std::Nat::+"} : core.i32
      tribute_control.return %2
  }
  tribute_control.func @main() -> core.nil row(| 0) convention(direct) attributes {inferred_row = true, row_binders = ["param"]} {
