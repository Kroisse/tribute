              %11 = core.unrealized_conversion_cast %1 : !t0
              %12 = core.unrealized_conversion_cast %10 : tribute_rt.anyref
              %13 = func.call_indirect %11, %12 : tribute_rt.anyref
              func.return %13
          }
          %14 = func.call %0, %6 {callee = @read, tribute.calling_convention = 2} : tribute_rt.anyref
          scf.yield %14
      } {
          %15 = arith.const {value = 0} : core.i32
          %16 = core.unrealized_conversion_cast %1 : !t0
          %17 = core.unrealized_conversion_cast %15 : tribute_rt.anyref
          %18 = func.call_indirect %16, %17 : tribute_rt.anyref
