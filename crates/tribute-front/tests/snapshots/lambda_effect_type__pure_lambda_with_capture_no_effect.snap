core.module @test {
  !t0 = core.array(adt.struct() {fields = [[@ability_id, core.i32], [@prompt_tag, core.i32], [@tr_dispatch_fn, core.ptr], [@handler_dispatch, core.ptr]], name = @_Marker})
  !t1 = closure.closure(core.func(tribute_rt.anyref, !t0, tribute_rt.anyref, core.i32))
  !t2 = closure.closure(core.func(tribute_rt.anyref, tribute_rt.anyref))

  func.func @apply(%0: !t0, %1: tribute_rt.anyref, %2: core.func(core.i32, core.i32), %3: core.i32) -> tribute_rt.anyref attributes {tribute.calling_convention = 2} {
      %4 = core.unrealized_conversion_cast %2 : !t1
      %5 = func.call_indirect %4, %0, %1, %3 {tribute.calling_convention = 2} : tribute_rt.anyref
      func.return %5
  }
  func.func @"test::__lambda_0"(%0: !t0, %1: tribute_rt.anyref, %2: tribute_rt.anyref) -> tribute_rt.anyref {
      func.return %2
  }
  func.func @main() -> core.i32 attributes {tribute.calling_convention = 0} {
      %0 = adt.ref_null {type = tribute_rt.anyref} : tribute_rt.anyref
      %1 = closure.new %0 {func_ref = @"test::__lambda_0"} : !t2
      %2 = arith.const {value = 10} : core.i32
      %3 = closure.lambda(%4: !t0, %5: tribute_rt.anyref, %6: core.i32) -> tribute_rt.anyref {tribute.calling_convention = 2} [%2] {
          %7 = func.call %6, %2 {callee = @"Nat::+", tribute.calling_convention = 0} : core.i32
          %8 = core.unrealized_conversion_cast %5 : !t2
          %9 = core.unrealized_conversion_cast %7 : tribute_rt.anyref
          %10 = func.call_indirect %8, %9 : tribute_rt.anyref
          func.return %10
      }
      %11 = arith.const {value = 32} : core.i32
      %12 = adt.ref_null {type = !t0} : !t0
      %13 = func.call %12, %1, %3, %11 {callee = @apply, tribute.calling_convention = 2} : tribute_rt.anyref
      %14 = core.unrealized_conversion_cast %13 : core.i32
      func.return %14
  }
}
