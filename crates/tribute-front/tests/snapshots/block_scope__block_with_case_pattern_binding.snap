  !"pkg::Option$Nat" = adt.enum<"pkg::Option$Nat" { Some(core.i32), None() }>

  tribute_control.func @"pkg::example"['a0](%0: adt.typeref<{name = "pkg::Option$Nat"}>) -> core.i32 row(| 'a0) inferred {
      %1 = adt.variant_is %0, Some : !"pkg::Option$Nat" -> core.i1
      %2 = scf.if %1 -> (core.i1) {
          %3 = adt.variant_get %0.Some[0] : !"pkg::Option$Nat" -> core.i32
          %4 = arith.constant true : core.i1
          scf.yield %4
      } else {
          %5 = arith.constant false : core.i1
          scf.yield %5
      }
      %6 = scf.if %2 -> (core.i32) {
          %7 = adt.variant_get %0.Some[0] : !"pkg::Option$Nat" -> core.i32
          scf.yield %7
      } else {
