core.module @test {
  tribute_control.func @"pkg::to_nat"['a0](%0: core.i1) -> core.i32 row(| 'a0) inferred {
      %1 = arith.constant true : core.i1
      %2 = arith.cmpi eq, %0, %1 : core.i1
      %3 = scf.if %2 -> (core.i32) {
          %4 = arith.constant 1 : core.i32
          scf.yield %4
      } else {
          %5 = arith.constant 0 : core.i32
          scf.yield %5
      }
      tribute_control.return %3
  }
