  func.func @test_lambda(%0: !t0, %1: tribute_rt.anyref) -> tribute_rt.anyref attributes {tribute.calling_convention = 2} {
      %2 = closure.lambda(%3: !t0, %4: tribute_rt.anyref, %5: core.i32) -> tribute_rt.anyref {tribute.calling_convention = 2} {
