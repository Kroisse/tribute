  !t1 = closure.closure(core.func(tribute_rt.anyref, !t0, tribute_rt.anyref, core.i32))

  func.func @apply(%0: !t0, %1: tribute_rt.anyref, %2: core.func(core.i32, core.i32), %3: core.i32) -> tribute_rt.anyref attributes {tribute.calling_convention = 2} {
