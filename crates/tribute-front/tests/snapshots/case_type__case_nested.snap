core.module @test {
  tribute_control.func @"pkg::nested"['a0](%0: core.i32, %1: core.i1) -> core.i32 row(| 'a0) inferred {
      %2 = arith.constant 0 : core.i32
      %3 = arith.cmpi eq, %0, %2 : core.i32
      %4 = scf.if %3 -> (core.i32) {
          %5 = arith.constant true : core.i1
          %6 = arith.cmpi eq, %1, %5 : core.i1
          %7 = scf.if %6 -> (core.i32) {
              %8 = arith.constant 10 : core.i32
              scf.yield %8
          } else {
              %9 = arith.constant 20 : core.i32
              scf.yield %9
          }
          scf.yield %7
      } else {
          %10 = arith.constant 30 : core.i32
          scf.yield %10
      }
      tribute_control.return %4
  }
}
