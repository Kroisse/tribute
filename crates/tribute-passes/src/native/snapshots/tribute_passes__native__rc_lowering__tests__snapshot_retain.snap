core.module @test {
  clif.func @f(%0: core.ptr) -> core.ptr {
      %1 = clif.iconst 0 : core.ptr
      %2 = clif.icmp eq, %0, %1 : core.ptr
      clif.brif %2 [^bb2, ^bb1]
    ^bb1:
      %3 = clif.iconst 8 : core.i64
      %4 = clif.isub %0, %3 : core.ptr
      %5 = clif.iconst 1 : core.i32
      %6 = clif.atomic_rmw %4, %5 {bin_op = "add", offset = 0} : core.i32
      clif.jump [^bb2]
    ^bb2:
      clif.return %0
  }
}
