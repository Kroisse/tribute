expression: result
---
core.module @test {
  !Base = adt.struct<(tribute_rt.convention_table_ref), {layout = "closure"}>
  !Captures = adt.struct<(tribute_rt.convention_table_ref, tribute_rt.anyref), {closure_base = !Base, layout = "closure_captures"}>
  !closure_captures = adt.struct<(core.ptr, tribute_rt.anyref), {closure_base = adt.struct<(core.ptr), {layout = "closure"}>, layout = "closure_captures"}>

  clif.func @test_fn(%0: core.ptr) -> core.i32 {
      %1 = clif.symbol_addr @__tribute_convention_table_0 : core.ptr
      %2 = adt.struct_new %1, %0 : (core.ptr, core.ptr) -> !closure_captures
      %3 = core.unrealized_conversion_cast %2 : !closure_captures to core.ptr
      %4 = adt.struct_get %3 {field = 0, type = !closure_captures} : core.ptr
      %5 = adt.struct_get %3 {field = 1, type = !closure_captures} : tribute_rt.anyref
      %6 = clif.load %4 {offset = 0} : core.i64
      %7 = core.unrealized_conversion_cast %5 : tribute_rt.anyref to core.ptr
      %8 = clif.call_indirect %6(%7) : (core.ptr) -> core.i32
      clif.return %8
  }
  clif.data @__tribute_convention_table_0(b"\0\0\0\0\0\0\0\0") align 8 {
      clif.func_reloc @lifted_fn at 0
  }
}
