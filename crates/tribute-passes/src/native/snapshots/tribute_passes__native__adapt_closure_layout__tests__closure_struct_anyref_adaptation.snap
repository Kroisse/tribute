---
source: crates/tribute-passes/src/native/adapt_closure_layout.rs
expression: result
---
core.module @test {
  !Base = adt.struct<_closure(code: core.i32), {layout = "closure"}>
  !Captures = adt.struct<_closure_captures(code: core.i32, _0: tribute_rt.anyref), {closure_base = !Base, layout = "closure_captures"}>
  !_closure_captures = adt.struct<_closure_captures(code: core.i64, _0: tribute_rt.anyref), {closure_base = adt.struct<_closure(code: core.i64), {layout = "closure"}>, layout = "closure_captures"}>
  !t0 = clif.func_sig<(core.ptr) -> core.i32>

  clif.func {sym_name = "test_fn", type = !t0} {
    ^bb0(%0: core.ptr):
      %1 = clif.symbol_addr {sym = @lifted_fn} : core.ptr
      %2 = adt.struct_new %1, %0 {type = !_closure_captures} : !_closure_captures
      %3 = core.unrealized_conversion_cast %2 : core.ptr
      %4 = adt.struct_get %3 {field = 0, type = !_closure_captures} : core.i64
      %5 = adt.struct_get %3 {field = 1, type = !_closure_captures} : tribute_rt.anyref
      %6 = core.unrealized_conversion_cast %5 : core.ptr
      %7 = clif.call_indirect %4, %6 {sig = !t0} : core.i32
      clif.return %7
  }
}
