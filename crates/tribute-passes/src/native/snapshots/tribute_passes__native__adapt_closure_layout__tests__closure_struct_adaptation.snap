core.module @test {
  !Base = adt.struct<_closure, (tribute_rt.convention_table_ref), {layout = "closure"}>
  !Captures = adt.struct<_closure_captures, (tribute_rt.convention_table_ref, core.ptr), {closure_base = !Base, layout = "closure_captures"}>
  !_closure_captures = adt.struct<_closure_captures, (core.ptr, core.ptr), {closure_base = adt.struct<_closure, (core.ptr), {layout = "closure"}>, layout = "closure_captures"}>

  clif.func @test_fn() -> core.i32 {
      %0 = clif.symbol_addr @__tribute_convention_table_0 : core.ptr
      %1 = mem.null : core.ptr
      %2 = adt.struct_new %0, %1 {type = !_closure_captures} : !_closure_captures
      %3 = core.unrealized_conversion_cast %2 : !_closure_captures to core.ptr
      %4 = adt.struct_get %3 {field = 0, type = !_closure_captures} : core.ptr
      %5 = adt.struct_get %3 {field = 1, type = !_closure_captures} : core.ptr
      %6 = clif.load %4 {offset = 0} : core.i64
      %7 = clif.call_indirect %6(%5) : (core.ptr) -> core.i32
      clif.return %7
  }
  clif.data @__tribute_convention_table_0(b"\0\0\0\0\0\0\0\0") align 8 {
      clif.func_reloc @lifted_fn at 0
  }
}
