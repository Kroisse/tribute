---
source: crates/tribute-passes/src/native/adapt_closure_layout.rs
expression: result
---
core.module @test {
  !_closure = adt.struct<_closure(func_ptr: core.i64, env: core.ptr), {layout = "closure"}>

  clif.func {sym_name = "test_fn", type = clif.func_sig<() -> core.i32>} {
      %0 = clif.symbol_addr {sym = @lifted_fn} : core.ptr
      %1 = mem.null : core.ptr
      %2 = adt.struct_new %0, %1 {type = !_closure} : !_closure
      %3 = core.unrealized_conversion_cast %2 : core.ptr
      %4 = adt.struct_get %3 {field = 0, type = !_closure} : core.i64
      %5 = adt.struct_get %3 {field = 1, type = !_closure} : core.ptr
      %6 = clif.call_indirect %4, %5 {sig = clif.func_sig<(core.ptr) -> core.i32>} : core.i32
      clif.return %6
  }
}
