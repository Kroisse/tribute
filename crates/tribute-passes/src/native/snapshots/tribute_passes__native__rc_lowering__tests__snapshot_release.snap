---
source: crates/tribute-passes/src/native/rc_lowering.rs
expression: result
---
core.module @test {
  clif.func @f(%0: core.ptr) -> core.nil {
      %1 = clif.iconst 0 : core.ptr
      %2 = clif.icmp eq, %0, %1 : core.ptr
      clif.brif %2 [^bb3, ^bb1]
    ^bb1:
      %3 = clif.iconst 8 : core.i64
      %4 = clif.isub %0, %3 : core.ptr
      %5 = clif.iconst 1 : core.i32
      %6 = clif.atomic_rmw %4, %5 {bin_op = "sub", offset = 0} : core.i32
      %7 = clif.icmp eq, %6, %5 : core.i32
      clif.brif %7 [^bb2, ^bb3]
    ^bb2:
      %8 = clif.iconst 12 : core.i64
      %9 = clif.call @__tribute_deep_release(%0, %8) : (core.ptr, core.i64) -> core.nil
      clif.jump [^bb3]
    ^bb3:
      clif.return
  }
}
