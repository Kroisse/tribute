core.module @test {
  !__tribute_cps_control = adt.enum() {name = @__tribute_cps_control, variants = [[@Normal, [tribute_rt.anyref]], [@Escape, [core.i32, tribute_rt.anyref]]]}

  func.func @run() -> core.i32 {
      %0 = arith.const {value = 10} : tribute_rt.anyref
      %1 = adt.variant_new %0 {tag = @Normal, type = !__tribute_cps_control} : tribute_rt.anyref
      %2 = arith.const {value = 1} : core.i32
      %3 = arith.const {value = 0} : tribute_rt.anyref
      %4 = arith.const {value = 0} : tribute_rt.anyref
      %5 = adt.variant_is %1 {tag = @Normal, type = !__tribute_cps_control} : core.i1
      %6 = scf.if %5 : core.i32 {
          %7 = adt.variant_cast %1 {tag = @Normal, type = !__tribute_cps_control} : tribute_rt.anyref
          %8 = adt.variant_get %7 {field = 0, tag = @Normal, type = !__tribute_cps_control} : tribute_rt.anyref
          %9 = arith.const {value = 1} : core.i32
          %10 = core.unrealized_conversion_cast %8 : core.i32
          %11 = arith.addi %10, %9 : core.i32
          scf.yield %11
      } {
          %12 = adt.variant_cast %1 {tag = @Escape, type = !__tribute_cps_control} : tribute_rt.anyref
          %13 = adt.variant_get %12 {field = 0, tag = @Escape, type = !__tribute_cps_control} : core.i32
          %14 = adt.variant_get %12 {field = 1, tag = @Escape, type = !__tribute_cps_control} : tribute_rt.anyref
          %15 = arith.cmpi %13, %2 {predicate = @eq} : core.i1
          %16 = scf.if %15 : core.i32 {
              %17 = core.unrealized_conversion_cast %14 : core.i32
              scf.yield %17
          } {
              %18 = core.unrealized_conversion_cast %1 : core.i32
              scf.yield %18
          }
          scf.yield %16
      }
      func.return %6
  }
}
